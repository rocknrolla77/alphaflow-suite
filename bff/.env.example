# Redis URL
# ─── ReputationBatcher (Module 6) ──────────────────────────────────────────────
# Приватный ключ кошелька-оракула (BFF Relayer) — должен совпадать с oracle в ReputationRegistry
# ВНИМАНИЕ: только для BFF, никогда не на клиенте!
RELAYER_PRIVATE_KEY=0x...

# Адрес задеплоенного ReputationRegistry.sol
REPUTATION_REGISTRY_ADDRESS=0x...

# Интервал агрегации голосов (ms, default: 300000 = 5 мин)
REPUTATION_BATCH_INTERVAL_MS=300000

# Макс. агентов в одном batch tx (gas safety, default: 50)
REPUTATION_MAX_AGENTS_PER_BATCH=50

# RPC с fallback (для отправки batch транзакций)
MANTLE_RPC_URL=https://rpc.testnet.mantle.xyz
MANTLE_RPC_FALLBACK_1=https://rpc.ankr.com/mantle_testnet
MANTLE_RPC_FALLBACK_2=https://mantle-testnet.public.blastapi.io

# ─── Core ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# HMAC secret (same as TG bot — shared secret between bot and BFF)
PROPOSAL_HMAC_SECRET=your_random_32_char_secret_here_please_change

# Mantle RPC
MANTLE_RPC_URL=https://rpc.mantle.xyz

# Deployed ActiveSentinel contract address
ACTIVE_SENTINEL_ADDRESS=0x0000000000000000000000000000000000000000

# Server port
PORT=3001

# Max staleness tolerance (%)
MAX_STALENESS_PCT=2

# Allowed TMA origin (CORS)
TMA_ORIGIN=https://alphaflow-tma.vercel.app
