# ═══════════════════════════════════════════════════════════════════════════════
# AlphaFlow Contracts - Deployment Environment
# Copy to .env.deploy and fill real values
# ═══════════════════════════════════════════════════════════════════════════════

# Deployer wallet private key (WITH MNT funds for gas)
DEPLOYER_PRIVATE_KEY=

# TEE Agent address (defaults to deployer if not set)
# TEE_AGENT_ADDRESS=0x...

# Mantle RPC
MANTLE_RPC_URL=https://rpc.mantle.xyz

# Mantle Explorer API key (optional, for rate limits)
# MANTLESCAN_API_KEY=
