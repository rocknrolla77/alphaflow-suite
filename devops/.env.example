# Telegram Bot Token (@BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Redis URL (для Pub/Sub и хранения proposals)
REDIS_URL=redis://localhost:6379

# Chat ID пользователя-владельца (получить через @userinfobot)
TARGET_CHAT_ID=123456789

# URL развёрнутого Telegram Mini App (React frontend)
MINI_APP_URL=https://alphaflow-tma.vercel.app

# HMAC секрет для подписи proposalId (min 32 chars)
PROPOSAL_HMAC_SECRET=your_random_32_char_secret_here_please_change

# TTL proposal в Redis (секунды, default: 300 = 5 мин)
PROPOSAL_TTL_SEC=300

# Максимальная задержка approve (секунды, default: 120 = 2 мин)
MAX_APPROVE_DELAY_SEC=120

# TOTP secret для 2FA подтверждения критических действий (опционально)
# Генерация: node -e "console.log(require('crypto').randomBytes(20).toString('base32'))"
# TOTP_SECRET=JBSWY3DPEHPK3PXP
