# AlphaFlow PWA — Environment Variables
# Copy to .env.local and fill in real values
# ═══════════════════════════════════════════════════════════════════════════════

# WebSocket endpoint for real-time TEE agent insights
VITE_BFF_WSS_URL=ws://localhost:3001/ws

# HTTP endpoint for BFF REST API (auth, proposals)
VITE_BFF_HTTP_URL=http://localhost:3001

# WalletConnect / Reown Project ID
# Get free at: https://dashboard.reown.com
VITE_WC_PROJECT_ID=
