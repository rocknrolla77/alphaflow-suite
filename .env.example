# ═══════════════════════════════════════════════════════════════════════
# AlphaFlow Suite — Unified Environment Configuration
# Copy to .env and fill in real values before deployment
# Phase 3: + Byreal OpenClaw, IPFS/Filecoin gateways, ERC-8004
# ═══════════════════════════════════════════════════════════════════════

# --- Infrastructure ---
NODE_ENV=production
REDIS_PASSWORD=CHANGE_ME_strong_random_password_here

# --- Mantle Network (Chain ID: 5000) ---
MANTLE_RPC_PRIMARY=https://rpc.mantle.xyz
MANTLE_RPC_FALLBACKS=https://mantle-rpc.publicnode.com,https://rpc.ankr.com/mantle

# --- Smart Contracts ---
ACTIVE_SENTINEL_ADDRESS=0x_DEPLOYED_ACTIVE_SENTINEL_ADDRESS
KERNEL_FACTORY_ADDRESS=0x_ZERODEV_KERNEL_V3_FACTORY
IDENTITY_REGISTRY_ADDRESS=0x_DEPLOYED_IDENTITY_REGISTRY
VALIDATION_REGISTRY_ADDRESS=0x_DEPLOYED_VALIDATION_REGISTRY

# --- Security & Signing ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROPOSAL_HMAC_SECRET=generate_64_char_hex_string_here

# --- TEE Agent (Phala CVM / Dev Mode) ---
# In production: keys are derived inside CVM via dstack-sdk
# In dev mode: use a funded testnet key
TEE_SIGNER_PRIVATE_KEY=0x_PRIVATE_KEY_FOR_DEV_ONLY
TEE_SIGNER_ADDRESS=0x_CORRESPONDING_ADDRESS
NANSEN_API_KEY=nansen_mcp_auth_token

# --- Byreal OpenClaw API (Phase 3) ---
# CLMM routing aggregator — replaces manual Merchant Moe / Agni calldata
BYREAL_API_URL=https://api.byreal.org
BYREAL_API_KEY=byreal_openclaw_api_key_here
# Max price impact threshold (bps). Reject quotes above this.
BYREAL_MAX_PRICE_IMPACT_BPS=300
# Request timeout (ms)
BYREAL_TIMEOUT_MS=15000

# --- Decentralized Storage (AgentCard Upload) ---
# IPFS: Pinata (recommended) or nft.storage
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=pinata_api_key_here
PINATA_SECRET_KEY=pinata_secret_key_here
# Filecoin storage deal (optional, for long-term persistence)
FILECOIN_GATEWAY_URL=https://api.node.glif.io/rpc/v1
# Arweave (alternative permanent storage)
ARWEAVE_GATEWAY_URL=https://arweave.net
ARWEAVE_WALLET_JWK_PATH=./keys/arweave-wallet.json

# --- ERC-8004 Agent Identity ---
# AgentCard URI (set after upload to IPFS/Arweave)
AGENT_CARD_URI=ipfs://bafkrei_YOUR_AGENT_CARD_CID_HERE
# Agent token ID (set after registration in IdentityRegistry)
AGENT_TOKEN_ID=1

# --- Bloom Filter Configuration ---
# Expected number of irrelevant addresses to cache
BLOOM_FILTER_EXPECTED_ITEMS=100000
# Target False Positive Rate (0.01 = 1%)
BLOOM_FILTER_FPR=0.01

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TARGET_CHAT_ID=123456789
MINI_APP_URL=https://alphaflow-tma.vercel.app

# --- Tuning (defaults are sane) ---
MAX_STALENESS_PCT=2
MAX_SLIPPAGE_PCT=2
PROPOSAL_TTL_SEC=300

# --- Deployment (Foundry) ---
DEPLOYER_PRIVATE_KEY=0x_DEPLOYER_KEY_FUNDED_WITH_MNT
INIT_CORE=0x_INIT_CAPITAL_CORE_ADDRESS_MANTLE
DEX_ROUTER_A=0x_MERCHANT_MOE_ROUTER_MANTLE
DEX_ROUTER_B=0x_AGNI_FINANCE_ROUTER_MANTLE
ORACLE_RELAYER_ADDRESS=0x_BFF_RELAYER_ADDRESS
TEE_AGENT_ADDRESS=0x_TEE_AGENT_EOA_OR_SMART_ACCOUNT

# --- Frontend (TMA) ---
# Deployed separately on Vercel/Cloudflare Pages
# VITE_BFF_URL=https://api.alphaflow.example.com
# VITE_KERNEL_FACTORY=0x...
