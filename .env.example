# ═══════════════════════════════════════════════════════════════════════
# AlphaFlow Suite — Unified Environment Configuration
# Copy to .env and fill in real values before deployment
# ═══════════════════════════════════════════════════════════════════════

# --- Infrastructure ---
NODE_ENV=production
REDIS_PASSWORD=CHANGE_ME_strong_random_password_here

# --- Mantle Network (Chain ID: 5000) ---
MANTLE_RPC_PRIMARY=https://rpc.mantle.xyz
MANTLE_RPC_FALLBACKS=https://mantle-rpc.publicnode.com,https://rpc.ankr.com/mantle

# --- Smart Contracts ---
ACTIVE_SENTINEL_ADDRESS=0x_DEPLOYED_ACTIVE_SENTINEL_ADDRESS
KERNEL_FACTORY_ADDRESS=0x_ZERODEV_KERNEL_V3_FACTORY

# --- Security & Signing ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROPOSAL_HMAC_SECRET=generate_64_char_hex_string_here

# --- TEE Agent (Phala CVM / Dev Mode) ---
# In production: keys are derived inside CVM via dstack-sdk
# In dev mode: use a funded testnet key
TEE_SIGNER_PRIVATE_KEY=0x_PRIVATE_KEY_FOR_DEV_ONLY
TEE_SIGNER_ADDRESS=0x_CORRESPONDING_ADDRESS
NANSEN_API_KEY=nansen_mcp_auth_token

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TARGET_CHAT_ID=123456789
MINI_APP_URL=https://alphaflow-tma.vercel.app

# --- Tuning (defaults are sane) ---
MAX_STALENESS_PCT=2
MAX_SLIPPAGE_PCT=2
PROPOSAL_TTL_SEC=300

# --- Frontend (TMA) ---
# Deployed separately on Vercel/Cloudflare Pages
# VITE_BFF_URL=https://api.alphaflow.example.com
# VITE_KERNEL_FACTORY=0x...
